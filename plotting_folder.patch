diff --git a/06_plotting/00_plot_basics.R b/06_plotting/00_plot_basics.R
new file mode 100644
index 0000000..2c58ea8
--- /dev/null
+++ b/06_plotting/00_plot_basics.R
@@ -0,0 +1,68 @@
+# 00_plot_basics.R - ggplot2 anatomy, aesthetics, scales, themes, facets, combining, saving.
+# Demo data runs as-is. To use your data, rename your columns to x, y, z, g, f (see DEMO DATA).
+library(tidyverse); library(scales); library(patchwork)
+
+# ---- DEMO DATA (replace with: df <- readRDS("out/clean.rds") |> rename(x = ..., y = ...)) ----
+# x, y = numeric   z = third numeric   g = category (many levels)   f = category (few levels)
+df <- mpg |> mutate(x = hwy, y = cty, z = displ, g = class, f = drv)
+
+# ---- ANATOMY: data -> aes -> geom -> scale -> facet -> coord -> theme ----
+ggplot(df, aes(x = x, y = y)) + geom_point()
+# map a column to a look INSIDE aes():   aes(colour = g)
+# set a constant look OUTSIDE aes():     geom_point(colour = "red")
+
+# ---- AESTHETICS: colour, fill, shape, size, alpha, linetype ----
+ggplot(df, aes(x, y, colour = g, shape = f, size = z)) + geom_point(alpha = .6)
+ggplot(df, aes(x, y)) + geom_point(colour = "steelblue", size = 2, alpha = .5)
+
+# ---- LABELS ----
+ggplot(df, aes(x, y, colour = f)) + geom_point() +
+  labs(title = "City vs highway mileage", subtitle = "By drive type",
+       x = "Highway (mpg)", y = "City (mpg)", colour = "Drive", caption = "Source: mpg data")
+
+# ---- SCALES ----
+p <- ggplot(df, aes(x, y, colour = g)) + geom_point()
+p + scale_x_continuous(limits = c(10, 50), breaks = seq(10, 50, 10))   # limits DROP data outside
+p + coord_cartesian(xlim = c(10, 40))                                    # zoom, keeps all data
+p + scale_x_log10() + scale_y_log10()                                    # log axes
+p + scale_x_reverse()                                                    # flip direction
+p + scale_y_continuous(labels = label_comma())                           # 1,000 style
+p + scale_colour_brewer(palette = "Set2")                                # discrete palette
+p + scale_colour_viridis_d()                                             # colour-blind friendly
+p + scale_colour_manual(values = c("#0072B2", "#E69F00", "#009E73", "#CC79A7",
+                                   "#D55E00", "#56B4E9", "#F0E442"))     # Okabe-Ito
+ggplot(df, aes(x, y, colour = z)) + geom_point() + scale_colour_viridis_c()          # continuous
+ggplot(df, aes(x, y, colour = z)) + geom_point() + scale_colour_gradient(low = "grey80", high = "red")
+ggplot(df, aes(x, y, colour = x - mean(x))) + geom_point() +
+  scale_colour_gradient2(low = "firebrick", mid = "white", high = "steelblue", midpoint = 0)  # diverging
+
+# ---- THEMES ----
+p + theme_minimal(); p + theme_bw(); p + theme_classic(); p + theme_light(); p + theme_void()
+theme_set(theme_minimal(base_size = 13))      # set once for the whole session
+p + theme(legend.position = "bottom", panel.grid.minor = element_blank(),
+          axis.text.x = element_text(angle = 45, hjust = 1))
+
+# ---- FACETS: small multiples ----
+ggplot(df, aes(x, y)) + geom_point() + facet_wrap(~ g)
+ggplot(df, aes(x, y)) + geom_point() + facet_wrap(~ g, scales = "free")   # free axes per panel
+ggplot(df, aes(x, y)) + geom_point() + facet_grid(f ~ year)               # rows ~ columns
+
+# ---- COORDINATES ----
+ggplot(df, aes(g)) + geom_bar() + coord_flip()                  # horizontal bars
+ggplot(df, aes(x, y)) + geom_point() + coord_fixed()            # equal x and y scale
+
+# ---- COMBINE PLOTS (patchwork) ----
+p1 <- ggplot(df, aes(x)) + geom_histogram(bins = 25)
+p2 <- ggplot(df, aes(x, y)) + geom_point()
+p3 <- ggplot(df, aes(g, x)) + geom_boxplot()
+p1 + p2                                   # side by side
+p1 / p2                                   # stacked
+(p1 | p2) / p3                            # grid layout
+(p1 | p2) / p3 + plot_annotation(title = "Overview", tag_levels = "A")
+(p2 + aes(colour = f)) + (p3 + aes(fill = f)) + plot_layout(guides = "collect")   # one shared legend
+
+# ---- SAVE ----
+dir.create("out", showWarnings = FALSE)
+ggsave("out/fig_basic.png", p, width = 8, height = 5, dpi = 300)    # report or doc
+ggsave("out/fig_slide.png", p, width = 13.33, height = 7.5, dpi = 200)   # full-slide
+ggsave("out/fig_basic.pdf", p, width = 8, height = 5)               # vector
diff --git a/06_plotting/01_distributions.R b/06_plotting/01_distributions.R
new file mode 100644
index 0000000..db6cfbe
--- /dev/null
+++ b/06_plotting/01_distributions.R
@@ -0,0 +1,71 @@
+# 01_distributions.R - one variable (x), optionally split by group (g, f). "What does it look like?"
+library(tidyverse); library(ggridges); library(scales)
+theme_set(theme_minimal(base_size = 13))
+
+# ---- DEMO DATA ----
+df <- mpg |> mutate(x = hwy, y = cty, g = class, f = drv)
+
+# ---- HISTOGRAMS ----
+ggplot(df, aes(x)) + geom_histogram(bins = 30, fill = "steelblue", colour = "white")
+ggplot(df, aes(x)) + geom_histogram(binwidth = 2)                          # set bin width instead
+ggplot(df, aes(x, fill = f)) + geom_histogram(bins = 30, position = "identity", alpha = .5)
+ggplot(df, aes(x)) + geom_histogram(bins = 30) + facet_wrap(~ f)           # one panel per group
+ggplot(df, aes(x)) + geom_histogram(bins = 30) + scale_x_log10()           # skewed variable
+
+# Histogram with density and a normal curve on top
+ggplot(df, aes(x)) +
+  geom_histogram(aes(y = after_stat(density)), bins = 30, fill = "grey85", colour = "white") +
+  geom_density(colour = "steelblue", linewidth = 1) +
+  stat_function(fun = dnorm, args = list(mean = mean(df$x), sd = sd(df$x)),
+                colour = "red", linetype = 2)
+
+# ---- DENSITY / FREQUENCY LINES ----
+ggplot(df, aes(x)) + geom_density(fill = "steelblue", alpha = .4)
+ggplot(df, aes(x, fill = f)) + geom_density(alpha = .4)
+ggplot(df, aes(x, colour = f)) + geom_freqpoly(bins = 30)
+ggplot(df, aes(x, after_stat(count), fill = f)) + geom_density(position = "stack")   # stacked counts
+
+# ---- BOXPLOT FAMILY ----
+ggplot(df, aes(g, x)) + geom_boxplot()
+ggplot(df, aes(fct_reorder(g, x, .fun = median), x)) + geom_boxplot() + coord_flip()  # ordered
+ggplot(df, aes(g, x, fill = f)) + geom_boxplot()                                       # dodged by 2nd group
+ggplot(df, aes(g, x)) + geom_boxplot(outlier.shape = NA) + geom_jitter(width = .15, alpha = .4)
+ggplot(df, aes(g, x)) + geom_violin(fill = "steelblue", alpha = .4)
+ggplot(df, aes(g, x)) + geom_violin(trim = FALSE, fill = "grey90") +
+  geom_boxplot(width = .12, outlier.shape = NA)                                        # violin + box
+ggplot(df, aes(g, x)) + stat_summary(fun.data = mean_se, geom = "pointrange")          # mean +/- 1 SE
+ggplot(df, aes(g, x)) + geom_dotplot(binaxis = "y", stackdir = "center", binwidth = 1) # every point
+
+# Rain-cloud style: half density + box + raw points
+ggplot(df, aes(f, x, fill = f)) +
+  geom_violin(alpha = .4, colour = NA) +
+  geom_boxplot(width = .12, outlier.shape = NA, fill = "white") +
+  geom_jitter(width = .08, alpha = .4, size = 1) + guides(fill = "none")
+
+# ---- RIDGELINES (many groups, one variable) ----
+ggplot(df, aes(x, y = fct_reorder(g, x, .fun = median), fill = g)) +
+  geom_density_ridges(alpha = .7, scale = 1.2) + guides(fill = "none") + labs(y = NULL)
+
+# ---- CUMULATIVE ----
+ggplot(df, aes(x, colour = f)) + stat_ecdf()                               # share of data below x
+
+# ---- NORMALITY (QQ) ----
+ggplot(df, aes(sample = x)) + stat_qq() + stat_qq_line(colour = "red")
+ggplot(df, aes(sample = x, colour = f)) + stat_qq() + stat_qq_line()       # by group
+
+# ---- RUG: raw positions under any plot ----
+ggplot(df, aes(x)) + geom_density() + geom_rug(alpha = .3)
+
+# ---- COUNTS OF A CATEGORY ----
+ggplot(df, aes(g)) + geom_bar()
+ggplot(df, aes(fct_infreq(g))) + geom_bar() + coord_flip() + labs(x = NULL)  # sorted by size
+
+# ---- MANY VARIABLES AT ONCE ----
+df |> select(where(is.numeric)) |> pivot_longer(everything()) |>
+  ggplot(aes(value)) + geom_histogram(bins = 25) + facet_wrap(~ name, scales = "free")
+df |> select(where(is.numeric)) |> pivot_longer(everything()) |>
+  ggplot(aes(name, value)) + geom_boxplot() + facet_wrap(~ name, scales = "free") +
+  theme(axis.text.x = element_blank())
+
+# ---- OUTLIER VIEW ----
+ggplot(df, aes(x)) + geom_histogram(bins = 40) + coord_cartesian(xlim = c(10, 40))   # zoom
diff --git a/06_plotting/02_relationships.R b/06_plotting/02_relationships.R
new file mode 100644
index 0000000..151a7bf
--- /dev/null
+++ b/06_plotting/02_relationships.R
@@ -0,0 +1,71 @@
+# 02_relationships.R - two or more numeric variables. "How are x and y related?"
+library(tidyverse); library(ggrepel); library(GGally); library(scales)
+theme_set(theme_minimal(base_size = 13))
+
+# ---- DEMO DATA ----
+df <- mpg |> mutate(x = hwy, y = cty, z = displ, g = class, f = drv)
+
+# ---- SCATTER ----
+ggplot(df, aes(x, y)) + geom_point()
+ggplot(df, aes(x, y, colour = f)) + geom_point(size = 2, alpha = .7)
+ggplot(df, aes(x, y, colour = f, shape = f)) + geom_point()
+ggplot(df, aes(x, y)) + geom_point() + facet_wrap(~ f)
+
+# Bubble: third numeric variable as size
+ggplot(df, aes(x, y, size = z, colour = f)) + geom_point(alpha = .5) + scale_size_area(max_size = 8)
+
+# ---- OVERLAPPING POINTS ----
+ggplot(df, aes(x, y)) + geom_jitter(width = .3, height = .3, alpha = .5)    # small random shift
+ggplot(df, aes(x, y)) + geom_count()                                         # size = how many
+ggplot(df, aes(x, y)) + geom_point(alpha = .1)                               # transparency
+ggplot(df, aes(x, y)) + geom_bin2d(bins = 20) + scale_fill_viridis_c()       # square bins
+ggplot(df, aes(x, y)) + geom_hex(bins = 15) + scale_fill_viridis_c()         # hexagon bins (needs hexbin)
+ggplot(df, aes(x, y)) + geom_density_2d()                                    # contour lines
+ggplot(df, aes(x, y)) + geom_density_2d_filled(alpha = .8)                   # filled contours
+
+# ---- TREND LINES ----
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth(method = "lm")            # straight line + 95% band
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth(method = "lm", se = FALSE, colour = "red")
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth()                         # loess: flexible curve
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth(method = "lm", formula = y ~ poly(x, 2))   # quadratic
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth(method = "gam", formula = y ~ s(x))        # spline
+ggplot(df, aes(x, y, colour = f)) + geom_point() + geom_smooth(method = "lm", se = FALSE)     # line per group
+ggplot(df, aes(x, y)) + geom_point() + geom_smooth(method = "lm") + facet_wrap(~ f)
+
+# ---- SHOW A LINE YOU ESTIMATED YOURSELF ----
+fit <- lm(y ~ x, data = df)
+ggplot(df, aes(x, y)) + geom_point() +
+  geom_abline(intercept = coef(fit)[1], slope = coef(fit)[2], colour = "red") +
+  geom_abline(intercept = 0, slope = 1, linetype = 2)                        # 45-degree reference
+
+# ---- LABEL POINTS ----
+ggplot(df, aes(x, y)) + geom_point() +
+  geom_text_repel(data = filter(df, x > 40), aes(label = model))             # label only some
+ggplot(df, aes(x, y)) + geom_point(colour = "grey70") +
+  geom_point(data = filter(df, f == "r"), colour = "red") +                  # highlight a subset
+  geom_text_repel(data = filter(df, f == "r"), aes(label = model), size = 3)
+
+# ---- RUGS AND REFERENCE LINES ----
+ggplot(df, aes(x, y)) + geom_point() + geom_rug(alpha = .3) +
+  geom_vline(xintercept = mean(df$x), linetype = 2) +
+  geom_hline(yintercept = mean(df$y), linetype = 2)
+
+# ---- CONNECTED POINTS (order matters) ----
+df |> group_by(year, cyl) |> summarise(x = mean(x), y = mean(y), .groups = "drop") |>
+  ggplot(aes(x, y, colour = factor(year), group = year)) + geom_path() + geom_point()
+
+# ---- CORRELATION HEATMAP ----
+cm <- df |> select(x, y, z, cyl, year) |> cor(use = "pairwise.complete.obs") |>
+  as.data.frame() |> rownames_to_column("a") |> pivot_longer(-a, names_to = "b", values_to = "r")
+ggplot(cm, aes(a, b, fill = r)) + geom_tile(colour = "white") +
+  geom_text(aes(label = round(r, 2)), size = 3.5) +
+  scale_fill_gradient2(low = "firebrick", mid = "white", high = "steelblue", limits = c(-1, 1)) +
+  labs(x = NULL, y = NULL, fill = "Correlation")
+
+# ---- SCATTERPLOT MATRIX ----
+ggpairs(df, columns = c("x", "y", "z"))
+ggpairs(df, columns = c("x", "y", "z"), mapping = aes(colour = f))
+
+# ---- ONE MEASURE ACROSS TWO CATEGORIES ----
+df |> group_by(g, f) |> summarise(m = mean(x), .groups = "drop") |>
+  ggplot(aes(f, g, fill = m)) + geom_tile() + scale_fill_viridis_c()
diff --git a/06_plotting/03_categorical_comparison.R b/06_plotting/03_categorical_comparison.R
new file mode 100644
index 0000000..5ed0b6a
--- /dev/null
+++ b/06_plotting/03_categorical_comparison.R
@@ -0,0 +1,75 @@
+# 03_categorical_comparison.R - categories: counts, group means, shares, flows. "How do groups compare?"
+library(tidyverse); library(scales); library(treemapify); library(ggalluvial)
+theme_set(theme_minimal(base_size = 13))
+
+# ---- DEMO DATA ----
+df <- mpg |> mutate(x = hwy, g = class, f = drv)
+# Pre-summarised table used by many plots below: mean, SE and 95% CI per group
+s <- df |> group_by(g) |>
+  summarise(n = n(), m = mean(x), se = sd(x) / sqrt(n), lo = m - 1.96 * se, hi = m + 1.96 * se)
+
+# ---- BARS: COUNTS ----
+ggplot(df, aes(g)) + geom_bar()
+ggplot(df, aes(y = fct_infreq(g))) + geom_bar() + labs(y = NULL)                    # sorted, horizontal
+ggplot(df, aes(g)) + geom_bar() + geom_text(stat = "count", aes(label = after_stat(count)), vjust = -.4)
+
+# ---- BARS: SPLIT BY A SECOND CATEGORY ----
+ggplot(df, aes(g, fill = f)) + geom_bar()                                            # stacked
+ggplot(df, aes(g, fill = f)) + geom_bar(position = position_dodge(preserve = "single"))   # side by side
+ggplot(df, aes(g, fill = f)) + geom_bar(position = "fill") +                         # shares, sum to 100%
+  scale_y_continuous(labels = percent) + labs(y = "Share")
+
+# ---- BARS: SHARES WITH LABELS ----
+df |> count(g) |> mutate(p = n / sum(n)) |>
+  ggplot(aes(fct_reorder(g, p), p)) + geom_col() + coord_flip() +
+  geom_text(aes(label = percent(p, accuracy = 1)), hjust = -.1) +
+  scale_y_continuous(labels = percent, expand = expansion(mult = c(0, .15))) + labs(x = NULL)
+
+# ---- BARS: GROUP MEANS WITH ERROR BARS ----
+ggplot(s, aes(fct_reorder(g, m), m)) + geom_col(fill = "steelblue") +
+  geom_errorbar(aes(ymin = lo, ymax = hi), width = .3) + coord_flip() + labs(x = NULL, y = "Mean (95% CI)")
+ggplot(df, aes(g, x)) + stat_summary(fun = mean, geom = "col") +                    # same, without pre-summarising
+  stat_summary(fun.data = mean_se, geom = "errorbar", width = .3)
+ggplot(s, aes(m, fct_reorder(g, m), xmin = lo, xmax = hi)) + geom_pointrange() + labs(y = NULL)   # dots + CI
+
+# ---- LOLLIPOP / CLEVELAND DOT (cleaner than bars) ----
+s |> mutate(g = fct_reorder(g, m)) |> ggplot(aes(m, g)) +
+  geom_segment(aes(x = 0, xend = m, yend = g), colour = "grey70") + geom_point(size = 3) + labs(y = NULL)
+ggplot(s, aes(m, fct_reorder(g, m))) + geom_point(size = 3) + labs(y = NULL)
+
+# ---- DIVERGING BAR: above / below the average ----
+s |> mutate(dev = m - mean(m)) |>
+  ggplot(aes(dev, fct_reorder(g, dev), fill = dev > 0)) + geom_col() +
+  scale_fill_manual(values = c("firebrick", "steelblue"), guide = "none") + labs(y = NULL, x = "Gap to average")
+
+# ---- BEFORE / AFTER ----
+w <- df |> group_by(g, year) |> summarise(m = mean(x), .groups = "drop")
+ggplot(w, aes(factor(year), m, group = g, colour = g)) + geom_line() + geom_point()        # slope chart
+w |> pivot_wider(names_from = year, values_from = m, names_prefix = "y") |>                # dumbbell
+  mutate(g = fct_reorder(g, y2008)) |> ggplot(aes(y = g)) +
+  geom_segment(aes(x = y1999, xend = y2008, yend = g), colour = "grey70") +
+  geom_point(aes(x = y1999), colour = "grey40", size = 3) +
+  geom_point(aes(x = y2008), colour = "steelblue", size = 3) + labs(x = "Mean", y = NULL)
+
+# ---- HEATMAP: two categories ----
+df |> count(g, f) |> ggplot(aes(f, g, fill = n)) + geom_tile() +
+  geom_text(aes(label = n), colour = "white") + scale_fill_viridis_c()
+
+# ---- COMPOSITION: TREEMAP ----
+df |> count(g) |> ggplot(aes(area = n, fill = g, label = g)) +
+  geom_treemap() + geom_treemap_text(colour = "white", place = "centre") + guides(fill = "none")
+
+# ---- COMPOSITION: PIE / DONUT (use sparingly; bars are easier to read) ----
+pie <- df |> count(f)
+ggplot(pie, aes(x = "", y = n, fill = f)) + geom_col(width = 1) + coord_polar(theta = "y") + theme_void()
+ggplot(pie, aes(x = 2, y = n, fill = f)) + geom_col(width = 1) + coord_polar(theta = "y") +
+  xlim(.5, 2.5) + theme_void()                                                              # donut
+
+# ---- FLOWS: ALLUVIAL / SANKEY STYLE ----
+df |> count(f, g) |>
+  ggplot(aes(axis1 = f, axis2 = g, y = n)) +
+  geom_alluvium(aes(fill = f)) + geom_stratum() +
+  geom_text(stat = "stratum", aes(label = after_stat(stratum)), size = 3) +
+  scale_x_discrete(limits = c("Drive", "Class"), expand = c(.1, .1)) + guides(fill = "none")
+
+# ---- COMPARE A NUMBER ACROSS GROUPS: see 01_distributions.R for box / violin / ridgeline ----
diff --git a/06_plotting/04_time_series_plots.R b/06_plotting/04_time_series_plots.R
new file mode 100644
index 0000000..407794f
--- /dev/null
+++ b/06_plotting/04_time_series_plots.R
@@ -0,0 +1,82 @@
+# 04_time_series_plots.R - change over time: lines, areas, seasonality, panels. Needs a date column.
+library(tidyverse); library(scales); library(zoo)
+theme_set(theme_minimal(base_size = 13))
+
+# ---- DEMO DATA ----
+# one series: date, value        many series: economics_long (date, variable, value, value01)
+# panel:      txhousing (city, year, month, date, sales)
+df <- economics |> transmute(date, value = unemploy)
+long <- economics_long
+tx <- txhousing |> filter(city %in% c("Austin", "Dallas", "Houston", "San Antonio"))
+
+# ---- LINES ----
+ggplot(df, aes(date, value)) + geom_line()
+ggplot(df |> slice_tail(n = 24), aes(date, value)) + geom_line() + geom_point()      # few points: show them
+ggplot(long, aes(date, value01, colour = variable)) + geom_line()                    # several series, one scale
+ggplot(long, aes(date, value)) + geom_line() + facet_wrap(~ variable, scales = "free_y")   # own scale each
+ggplot(df, aes(date, value)) + geom_step()                                           # steps (rates, policies)
+
+# ---- DATE AXIS ----
+ggplot(df, aes(date, value)) + geom_line() +
+  scale_x_date(date_breaks = "10 years", date_labels = "%Y") +
+  scale_y_continuous(labels = label_comma())
+# limits: scale_x_date(limits = as.Date(c("2000-01-01", "2015-01-01")))
+
+# ---- TREND, BANDS, ROLLING AVERAGE ----
+ggplot(df, aes(date, value)) + geom_line(colour = "grey70") + geom_smooth(span = .2, colour = "red", se = FALSE)
+ggplot(df, aes(date, value)) + geom_line(colour = "grey70") +
+  geom_line(aes(y = rollmean(value, 12, fill = NA, align = "right")), colour = "steelblue", linewidth = 1)
+ggplot(df, aes(date, value)) + geom_ribbon(aes(ymin = value * .9, ymax = value * 1.1), alpha = .2) + geom_line()
+# ^ replace ymin / ymax with real confidence or forecast bands
+
+# ---- AREAS ----
+ggplot(df, aes(date, value)) + geom_area(fill = "steelblue", alpha = .5)
+ggplot(tx, aes(date, sales, fill = city)) + geom_area()                              # stacked totals
+ggplot(tx, aes(date, sales, fill = city)) + geom_area(position = "fill") +           # shares over time
+  scale_y_continuous(labels = percent)
+
+# ---- MARK EVENTS AND PERIODS ----
+ggplot(df, aes(date, value)) +
+  annotate("rect", xmin = as.Date("2007-12-01"), xmax = as.Date("2009-06-01"),
+           ymin = -Inf, ymax = Inf, alpha = .2, fill = "grey40") +                   # shaded period
+  geom_vline(xintercept = as.Date("2008-09-15"), linetype = 2) +                     # single event
+  annotate("text", x = as.Date("2008-09-15"), y = max(df$value), label = "Event", hjust = 1.1) +
+  geom_line()
+
+# ---- TWO UNITS ON ONE PLOT: second axis (use with care) ----
+ggplot(economics, aes(date)) +
+  geom_line(aes(y = unemploy), colour = "steelblue") +
+  geom_line(aes(y = psavert * 500), colour = "firebrick") +                          # rescale the second series
+  scale_y_continuous(name = "Unemployed", sec.axis = sec_axis(~ . / 500, name = "Saving rate (%)"))
+
+# ---- INDEX AND GROWTH ----
+long |> group_by(variable) |> mutate(idx = value / first(value) * 100) |>
+  ggplot(aes(date, idx, colour = variable)) + geom_line() + scale_y_log10() + labs(y = "Index (start = 100)")
+df |> mutate(yoy = value / lag(value, 12) - 1) |>
+  ggplot(aes(date, yoy)) + geom_col() + scale_y_continuous(labels = percent)         # growth rate bars
+
+# ---- SEASONALITY ----
+au <- txhousing |> filter(city == "Austin")
+ggplot(au, aes(month, sales, group = year, colour = factor(year))) + geom_line() +   # one line per year
+  scale_x_continuous(breaks = 1:12)
+ggplot(au, aes(factor(month), factor(year), fill = sales)) + geom_tile() +           # calendar heatmap
+  scale_fill_viridis_c() + labs(x = "Month", y = NULL)
+ggplot(au, aes(factor(month), sales)) + geom_boxplot()                               # typical month pattern
+
+# ---- PANEL DATA: MANY UNITS OVER TIME ----
+ggplot(txhousing, aes(date, sales, group = city)) + geom_line(alpha = .3)            # spaghetti
+ggplot(txhousing, aes(date, sales, group = city)) + geom_line(colour = "grey80") +
+  geom_line(data = filter(txhousing, city == "Austin"), colour = "red", linewidth = 1)   # highlight one
+ggplot(tx, aes(date, sales)) + geom_line() + facet_wrap(~ city)                      # small multiples
+txhousing |> group_by(date) |> summarise(m = mean(sales, na.rm = TRUE)) |>           # average over units
+  ggplot(aes(date, m)) + geom_line()
+
+# ---- AUTOCORRELATION PLOT ----
+a <- acf(df$value, lag.max = 36, plot = FALSE)
+ggplot(tibble(lag = a$lag[, 1, 1], acf = a$acf[, 1, 1]), aes(lag, acf)) + geom_col(width = .2) +
+  geom_hline(yintercept = c(-1, 1) * qnorm(.975) / sqrt(a$n.used), linetype = 2, colour = "blue")
+
+# ---- DECOMPOSITION ----
+dec <- stl(ts(df$value, start = c(1967, 7), frequency = 12), s.window = "periodic")
+bind_cols(date = df$date, as.data.frame(dec$time.series), observed = df$value) |>
+  pivot_longer(-date) |> ggplot(aes(date, value)) + geom_line() + facet_wrap(~ name, ncol = 1, scales = "free_y")
